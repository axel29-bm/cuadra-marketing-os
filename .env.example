# Copia este archivo como .env (no se sube a git) solo si necesitas cambiar algo.
# Ninguna clave es obligatoria: el sistema funciona entero en modo ASISTIDO.

# Carpeta de datos vivos (base, tareas, salidas, respaldos). Por defecto: ./espacio
# MOS_ESPACIO=C:\Users\Didi\MarketingOS\espacio

# Modo de IA: ASISTIDO (por defecto), LOCAL (Ollama) o EXTERNO (requiere autorización en la base).
# MOS_IA_MODO=ASISTIDO

# Para el modo LOCAL con Ollama:
# MOS_IA_URL=http://127.0.0.1:11434/v1
# MOS_IA_MODELO=qwen3.5:4b

# Tope de llamadas de IA por día (local o externa)
# MOS_IA_LIMITE_DIARIO=40

# Modo EXTERNO: solo después de `python -m mos autorizar IA_EXTERNA`. La clave nunca va en un archivo del repositorio.
# MOS_IA_CLAVE=

# Puerto del panel web local
# MOS_PUERTO=8765
