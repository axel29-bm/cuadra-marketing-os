{% extends "_base/base.html.j2" %}
{% block estilos %}
.motivo { right: calc(-260 * var(--u)); top: 34%; width: calc(440 * var(--u)); }
.formato-enlace .motivo { display: none; }
.formato-enlace .boleto { align-self: center; }
.titular { font-size: calc(86 * var(--u)); }
.boleto { border-radius: var(--r); background: var(--oscuro); color: var(--oscuro-texto); padding: calc(40 * var(--u)); display: flex; flex-direction: column; gap: calc(26 * var(--u)); position: relative; }
.boleto h2 { font: 700 calc(22 * var(--u)) / 1 var(--fuente-texto); letter-spacing: .08em; text-transform: uppercase; color: var(--destacado); }
.boleto .punto { color: var(--oscuro-texto); font-size: calc(32 * var(--u)); }
.boleto .punto .marca-punto { background: var(--destacado); color: var(--destacado-texto); }
.modalidad { display: flex; align-items: center; gap: calc(16 * var(--u)); padding-top: calc(24 * var(--u)); border-top: calc(2 * var(--u)) dashed color-mix(in srgb, var(--oscuro-texto) 30%, transparent);
  font: 560 calc(28 * var(--u)) / 1.2 var(--fuente-texto); }
.modalidad span { width: calc(40 * var(--u)); height: calc(40 * var(--u)); color: var(--destacado); flex: none; }
.nota { font: 500 calc(24 * var(--u)) / 1.3 var(--fuente-texto); color: var(--texto-suave); }
.formato-cuadrado .titular { font-size: calc(70 * var(--u)); }
.formato-cuadrado .boleto { padding: calc(30 * var(--u)); gap: calc(18 * var(--u)); }
.formato-cuadrado .boleto .punto { font-size: calc(28 * var(--u)); }
.formato-historia .lienzo { padding-top: calc(150 * var(--u)); padding-bottom: calc(170 * var(--u)); }
.formato-enlace .lienzo { flex-direction: row; align-items: stretch; gap: calc(50 * var(--u)); }
.formato-enlace .izq { flex: 1; display: flex; flex-direction: column; gap: calc(28 * var(--u)); justify-content: center; }
.formato-enlace .boleto { flex: 0 0 44%; justify-content: center; }
.formato-enlace .titular { font-size: calc(72 * var(--u)); }
{% endblock %}
{% block fondo %}<div class="motivo"><i></i><i></i><i></i><i></i></div>{% endblock %}
{% block contenido %}
{% if formato == "enlace" %}
<div class="izq"><div class="marca">{% if logo %}<img src="{{ logo }}" alt="">{% endif %}<b>{{ nombre_marca }}</b></div>
  {% if antetitulo %}<div class="antetitulo">{{ antetitulo }}</div>{% endif %}<h1 class="titular ajustar">{{ titular | resaltar }}</h1>
  <div class="cta">{{ cta }}<span class="flecha">{{ icono("arrow-right") }}</span></div></div>
<div class="boleto caja-ajuste"><h2>Lo que vas a ver</h2><ul class="puntos">{% for p in que_veras %}<li class="punto ajustar"><span class="marca-punto">{{ icono("play") }}</span><span>{{ p }}</span></li>{% endfor %}</ul></div>
{% else %}
<div class="cabecera"><div class="marca">{% if logo %}<img src="{{ logo }}" alt="">{% endif %}<b>{{ nombre_marca }}</b></div>
  {% if antetitulo %}<div class="antetitulo">{{ antetitulo }}</div>{% endif %}</div>
<div class="empuje"></div>
<h1 class="titular ajustar">{{ titular | resaltar }}</h1>
<div class="boleto"><h2>Lo que vas a ver</h2>
  <ul class="puntos">{% for p in que_veras %}<li class="punto ajustar"><span class="marca-punto">{{ icono("play") }}</span><span>{{ p }}</span></li>{% endfor %}</ul>
  {% if modalidad %}<div class="modalidad"><span>{{ icono("calendar-check") }}</span>{{ modalidad }}</div>{% endif %}</div>
<div class="empuje"></div>
<div class="pie-fila"><p class="nota">{{ nota or "" }}</p><div class="cta">{{ cta }}<span class="flecha">{{ icono("arrow-right") }}</span></div></div>
{% endif %}
{% endblock %}
