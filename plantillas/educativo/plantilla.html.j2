{% extends "_base/base.html.j2" %}
{% block estilos %}
.motivo { right: calc(-120 * var(--u)); top: calc(-120 * var(--u)); width: calc(360 * var(--u)); }
.titular { max-width: 92%; }
.formato-cuadrado .titular { font-size: calc(76 * var(--u)); }
.formato-historia .lienzo { padding-top: calc(140 * var(--u)); padding-bottom: calc(160 * var(--u)); }
.formato-historia .titular { font-size: calc(96 * var(--u)); }
.formato-historia .punto { font-size: calc(38 * var(--u)); }
.caja-puntos { background: var(--superficie); border-radius: var(--r); padding: calc(40 * var(--u)) calc(40 * var(--u)); }
.formato-cuadrado .caja-puntos { padding: calc(30 * var(--u)) calc(34 * var(--u)); }
.formato-cuadrado .punto { font-size: calc(30 * var(--u)); }
.formato-cuadrado .puntos { gap: calc(14 * var(--u)); }
.nota { font: 600 calc(28 * var(--u)) / 1.3 var(--fuente-texto); color: var(--acento); }
{% endblock %}
{% block fondo %}<div class="motivo"><i></i><i></i><i></i><i></i></div>{% endblock %}
{% block contenido %}
<div class="cabecera"><div class="marca">{% if logo %}<img src="{{ logo }}" alt="">{% endif %}<b>{{ nombre_marca }}</b></div></div>
<div class="empuje"></div>
{% if antetitulo %}<div class="antetitulo">{{ antetitulo }}</div>{% endif %}
<h1 class="titular ajustar">{{ titular | resaltar }}</h1>
<div class="caja-puntos"><ul class="puntos">
{% for p in puntos %}<li class="punto ajustar"><span class="marca-punto">{{ icono("check") }}</span><span>{{ p | resaltar }}</span></li>{% endfor %}
</ul></div>
<div class="empuje"></div>
<div class="pie-fila">
  <div>{% if nota %}<p class="nota">{{ nota }}</p>{% endif %}</div>
  {% if cta %}<div class="cta">{{ cta }}<span class="flecha">{{ icono("arrow-right") }}</span></div>{% endif %}
</div>
{% endblock %}
