{% extends "_base/base.html.j2" %}
{% block estilos %}
.motivo { left: calc(-230 * var(--u)); bottom: calc(-230 * var(--u)); width: calc(440 * var(--u)); }
.titular { font-size: calc(84 * var(--u)); }
.oferta { border-radius: var(--r); background: var(--destacado); color: var(--destacado-texto); padding: calc(40 * var(--u)) calc(44 * var(--u)); display: flex; flex-direction: column; gap: calc(14 * var(--u)); }
.oferta .que { font: 700 calc(44 * var(--u)) / 1.1 var(--fuente-titulos); letter-spacing: -0.02em; }
.oferta .precio { font: 750 calc(76 * var(--u)) / 1 var(--fuente-titulos); letter-spacing: -0.03em; }
.oferta .precio small { font: 600 calc(26 * var(--u)) / 1 var(--fuente-texto); margin-left: calc(12 * var(--u)); letter-spacing: 0; }
.condiciones { font: 450 calc(25 * var(--u)) / 1.4 var(--fuente-texto); color: var(--texto-suave); }
.vigencia { display: flex; align-items: center; gap: calc(14 * var(--u)); font: 650 calc(28 * var(--u)) / 1.2 var(--fuente-texto); color: var(--tinta); }
.vigencia span { width: calc(36 * var(--u)); height: calc(36 * var(--u)); color: var(--acento); flex: none; }
.formato-cuadrado .titular { font-size: calc(68 * var(--u)); }
.formato-historia .lienzo { padding-top: calc(150 * var(--u)); padding-bottom: calc(170 * var(--u)); }
{% endblock %}
{% block fondo %}<div class="motivo"><i></i><i></i><i></i><i></i></div>{% endblock %}
{% block contenido %}
<div class="cabecera"><div class="marca">{% if logo %}<img src="{{ logo }}" alt="">{% endif %}<b>{{ nombre_marca }}</b></div>
  {% if antetitulo %}<div class="antetitulo">{{ antetitulo }}</div>{% endif %}</div>
<div class="empuje"></div>
<h1 class="titular ajustar">{{ titular | resaltar }}</h1>
<div class="oferta"><p class="que ajustar">{{ oferta }}</p>{% if precio %}<p class="precio ajustar">{{ precio }}{% if precio_nota %}<small>{{ precio_nota }}</small>{% endif %}</p>{% endif %}</div>
<p class="vigencia"><span>{{ icono("calendar-check") }}</span>{{ vigencia }}</p>
<p class="condiciones ajustar">{{ condiciones }}</p>
<div class="empuje"></div>
<div class="pie-fila"><div></div><div class="cta">{{ cta }}<span class="flecha">{{ icono("arrow-right") }}</span></div></div>
{% endblock %}
