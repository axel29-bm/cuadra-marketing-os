{% extends "_base/base.html.j2" %}
{% block estilos %}
.banda { display: flex; align-items: center; justify-content: space-between; gap: var(--e); padding-bottom: calc(26 * var(--u));
  border-bottom: calc(3 * var(--u)) solid var(--tinta); }
.radar { display: flex; align-items: center; gap: calc(14 * var(--u)); font: 700 calc(26 * var(--u)) / 1 var(--fuente-texto);
  letter-spacing: .06em; text-transform: uppercase; color: var(--tinta); }
.radar .icono-mini { width: calc(40 * var(--u)); height: calc(40 * var(--u)); color: var(--acento); }
.fecha { font: 600 calc(26 * var(--u)) / 1 var(--fuente-mono); color: var(--texto-suave); }
.org { display: flex; align-items: baseline; gap: calc(16 * var(--u)); flex-wrap: wrap; }
.org b { font: 750 calc(30 * var(--u)) / 1 var(--fuente-texto); background: var(--tinta); color: var(--oscuro-texto); padding: calc(10 * var(--u)) calc(16 * var(--u)); border-radius: var(--rc); }
.org span { font: 500 calc(24 * var(--u)) / 1.3 var(--fuente-texto); color: var(--texto-suave); }
.titular { font-size: calc(80 * var(--u)); }
.cambios { background: var(--superficie); border-radius: var(--r); padding: calc(34 * var(--u)) calc(38 * var(--u)); display: flex; flex-direction: column; gap: calc(18 * var(--u)); }
.cambios h2, .dato h2 { font: 700 calc(22 * var(--u)) / 1 var(--fuente-texto); letter-spacing: .08em; text-transform: uppercase; color: var(--acento); }
.cambios .punto { font-size: calc(31 * var(--u)); font-weight: 500; }
.cambios .marca-punto { background: color-mix(in srgb, var(--acento) 12%, var(--fondo)); color: var(--acento); }
.datos { display: grid; grid-template-columns: 1fr 1fr; gap: var(--e); }
.dato { border: calc(2 * var(--u)) solid var(--borde); border-radius: var(--r); padding: calc(26 * var(--u)) calc(30 * var(--u)); display: flex; flex-direction: column; gap: calc(12 * var(--u)); }
.dato p { font: 560 calc(28 * var(--u)) / 1.3 var(--fuente-texto); color: var(--tinta); }
.fuente { display: flex; gap: calc(14 * var(--u)); align-items: flex-start; font: 500 calc(23 * var(--u)) / 1.35 var(--fuente-texto); color: var(--texto-suave); }
.fuente .icono-mini { flex: none; width: calc(32 * var(--u)); height: calc(32 * var(--u)); color: var(--tinta); }
.fuente b { color: var(--tinta); }
.formato-cuadrado .titular { font-size: calc(62 * var(--u)); }
.formato-cuadrado .cambios .punto { font-size: calc(27 * var(--u)); }
.formato-cuadrado .cambios { padding: calc(24 * var(--u)) calc(30 * var(--u)); gap: calc(12 * var(--u)); }
.formato-historia .lienzo { padding-top: calc(130 * var(--u)); padding-bottom: calc(150 * var(--u)); }
.formato-historia .titular { font-size: calc(84 * var(--u)); }
{% endblock %}
{% block contenido %}
<div class="banda"><div class="radar"><span class="icono-mini">{{ icono("newspaper") }}</span>Radar normativo</div>
  <div class="marca">{% if logo %}<img src="{{ logo }}" alt="">{% endif %}<b>{{ nombre_marca }}</b></div></div>
<div class="org"><b>{{ organismo }}</b>{% if norma %}<span>{{ norma }}</span>{% endif %}<span class="fecha">{{ fecha_publicacion }}</span></div>
<h1 class="titular ajustar">{{ titular | resaltar }}</h1>
<div class="cambios"><h2>Qué cambia</h2><ul class="puntos">
{% for p in que_cambia %}<li class="punto ajustar"><span class="marca-punto">{{ icono("arrow-right") }}</span><span>{{ p | resaltar }}</span></li>{% endfor %}
</ul></div>
{% if afecta_a or vigencia %}<div class="datos">
  {% if afecta_a %}<div class="dato"><h2>A quién afecta</h2><p class="ajustar">{{ afecta_a }}</p></div>{% endif %}
  {% if vigencia %}<div class="dato"><h2>Desde cuándo</h2><p class="ajustar">{{ vigencia }}</p></div>{% endif %}
</div>{% endif %}
<div class="empuje"></div>
<p class="fuente"><span class="icono-mini">{{ icono("file-check-2") }}</span><span><b>Fuente oficial:</b> {{ fuente }}. Resumen informativo: lee la norma completa antes de aplicarla.</span></p>
{% endblock %}
