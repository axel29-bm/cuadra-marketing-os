{% extends "_base/base.html.j2" %}
{% block clase_body %}{% if pagina == 1 %} respuesta{% endif %}{% endblock %}
{% block estilos %}
.motivo { right: calc(-170 * var(--u)); top: calc(-170 * var(--u)); width: calc(400 * var(--u)); }
.titular { font-size: calc(70 * var(--u)); }
.opciones { display: flex; flex-direction: column; gap: calc(18 * var(--u)); }
.opcion { display: flex; align-items: center; gap: calc(22 * var(--u)); border: calc(2.5 * var(--u)) solid var(--borde); border-radius: var(--r);
  padding: calc(24 * var(--u)) calc(28 * var(--u)); font: 560 calc(34 * var(--u)) / 1.25 var(--fuente-texto); color: var(--tinta); background: var(--fondo); }
.opcion .letra { flex: none; width: calc(60 * var(--u)); height: calc(60 * var(--u)); border-radius: var(--rc); background: var(--superficie);
  display: grid; place-items: center; font: 750 calc(30 * var(--u)) / 1 var(--fuente-titulos); color: var(--tinta); }
.respuesta .opcion { opacity: .45; }
.respuesta .opcion.ok { opacity: 1; border-color: var(--exito); background: color-mix(in srgb, var(--exito) 8%, var(--fondo)); }
.respuesta .opcion.ok .letra { background: var(--exito); color: #fff; }
.respuesta .opcion.ok .letra svg { width: 60%; height: 60%; }
.invita { display: flex; align-items: center; gap: calc(14 * var(--u)); font: 650 calc(30 * var(--u)) / 1.2 var(--fuente-texto); color: var(--acento); }
.invita span { width: calc(40 * var(--u)); height: calc(40 * var(--u)); flex: none; }
.explica { background: var(--superficie); border-radius: var(--r); padding: calc(30 * var(--u)) calc(34 * var(--u)); }
.explica .texto { color: var(--tinta); font-size: calc(32 * var(--u)); }
.fuente { font: 500 calc(22 * var(--u)) / 1.3 var(--fuente-texto); color: var(--texto-suave); margin-top: calc(14 * var(--u)); }
.formato-cuadrado .titular { font-size: calc(58 * var(--u)); }
.formato-cuadrado .opcion { padding: calc(16 * var(--u)) calc(24 * var(--u)); font-size: calc(30 * var(--u)); }
.formato-historia .lienzo { padding-top: calc(140 * var(--u)); padding-bottom: calc(160 * var(--u)); }
.formato-historia .titular { font-size: calc(80 * var(--u)); }
{% endblock %}
{% block fondo %}<div class="motivo"><i></i><i></i><i></i><i></i></div>{% endblock %}
{% block contenido %}
<div class="cabecera"><div class="marca">{% if logo %}<img src="{{ logo }}" alt="">{% endif %}<b>{{ nombre_marca }}</b></div></div>
<div class="empuje"></div>
<div class="antetitulo">{{ tema or "Trivia" }}{% if pagina == 1 %} · respuesta{% endif %}</div>
<h1 class="titular ajustar">{{ pregunta | resaltar }}</h1>
<div class="opciones">
{% for o in opciones %}<div class="opcion ajustar{{ ' ok' if loop.index == correcta }}"><span class="letra">{% if pagina == 1 and loop.index == correcta %}{{ icono("check") }}{% else %}{{ "ABCD"[loop.index0] }}{% endif %}</span><span>{{ o }}</span></div>{% endfor %}
</div>
{% if pagina == 0 %}
<div class="empuje"></div>
<p class="invita"><span>{{ icono("message-circle") }}</span>Responde con la letra en los comentarios. La respuesta, en la siguiente lámina.</p>
{% else %}
<div class="explica"><p class="texto ajustar">{{ explicacion | resaltar }}</p>{% if fuente %}<p class="fuente">Fuente: {{ fuente }}</p>{% endif %}</div>
<div class="empuje"></div>
{% if cta %}<div class="pie-fila"><div></div><div class="cta">{{ cta }}<span class="flecha">{{ icono("arrow-right") }}</span></div></div>{% endif %}
{% endif %}
{% endblock %}
